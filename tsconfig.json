{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [".astro/types.d.ts", "**/*"],
  // `postbuild` assembles a complete deploy application in release/, including
  // bundled dependency sources. They are output, not code this product owns.
  // `.claude/` holds agent worktrees — full second checkouts of this repo.
  "exclude": ["dist", "release", "node_modules", ".claude"]
}
